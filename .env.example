# Copy to .env before running: cp .env.example .env
#
# Local development values only. Nothing here is a real secret, and nothing
# here is reused in deployment (Iteration 8).

# --- Postgres superuser (seeding + role creation) -------------------------
# The API never receives these credentials. See specs/000-project.md section 4.
POSTGRES_USER=querypilot
POSTGRES_PASSWORD=localdevonly
POSTGRES_DB=chinook

# --- Read-only role: the ONLY credential the API gets ---------------------
# Gate 1 of the safety layer. Keep the password alphanumeric: it is
# interpolated into a DSN in docker-compose.yml, so @ : / # would need
# percent-encoding.
QUERYPILOT_RO_USER=querypilot_ro
QUERYPILOT_RO_PASSWORD=readonlylocaldev

# --- Host port mappings ---------------------------------------------------
POSTGRES_PORT=5432
API_PORT=8000

# --- Gate 3: resource limits ---------------------------------------------
# Pinned to the querypilot_ro role at init time via ALTER ROLE ... SET.
# Any valid Postgres interval string: 10s, 5000ms, 1min.
# Changing this requires recreating the volume (docker compose down -v).
QUERYPILOT_STATEMENT_TIMEOUT=10s

# --- LLM provider (Iteration 2) -------------------------------------------
# Groq is the default; the provider stays swappable behind api/llm/.
# Put the real key in .env (gitignored), never in .env.example and never in
# a commit. Get one at https://console.groq.com/keys
QUERYPILOT_LLM_PROVIDER=groq
QUERYPILOT_LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# --- Who may spend that quota (Iteration 10) ------------------------------
# HTTP Basic. A JSON object of name to secret; add a caller by adding an
# entry. Read at request time, so rotating a secret is an edit here plus a
# restart of nothing -- no rebuild, no code change.
#
# The value below is a LOCAL DEVELOPMENT CREDENTIAL on exactly the same terms
# as the Postgres passwords above: it is in a public repository, so it is not
# a secret and must be replaced before this is reachable by anyone else.
# Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Leaving this blank is safe and fails closed: /health keeps answering and
# says the variable is unset, and every other route returns 401. It is a
# refusal to work, never a silent opening.
#
# Basic sends the secret base64-encoded, which is encoding and not encryption.
# Over plain HTTP anyone on the path can read it. TLS is a deployment concern
# and belongs to B-11; see the README's security section.
QUERYPILOT_USERS={"analyst":"localdevonly-change-me"}

# Host runs only -- the eval runner and any script started outside
# docker compose. Compose sets this itself for the API container, to
# `@db:5432`, so leaving this blank breaks nothing in the container path.
# Use the read-only role and the mapped port:
#   postgresql+psycopg://${QUERYPILOT_RO_USER}:${QUERYPILOT_RO_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
QUERYPILOT_DATABASE_URL=

# --- Iteration 12: deployment -------------------------------------------------

# Whose `X-Forwarded-Proto` this deployment believes (T6).
#
# Comma-separated CIDRs. Empty means the default: loopback plus the RFC-1918
# range Docker allocates bridge networks from, which is what lets the `tls`
# profile work with no configuration here.
#
# Getting this wrong is silent in both directions. Too wide and any client can
# claim HTTPS, which makes the HSTS header a lie it tells on its own behalf;
# too narrow and a correct deployment behind a terminator never emits HSTS at
# all. `/health` reports the resolved networks so it can be checked.
QUERYPILOT_TRUSTED_PROXIES=

# File-based secrets (T8).
#
# An environment variable is part of the container's configuration, so
# `docker inspect` prints it in full and anything holding the Docker socket can
# read it. Point these at a path instead and the value stays in a file.
#
# The file form wins when both are set. A path that cannot be read fails
# closed -- it does NOT fall back to the variable -- and `/health` reports
# `source` and `readable` for each secret.
#
# Anything under `deploy/secrets/` is mounted read-only at `/run/secrets`:
#   QUERYPILOT_USERS_FILE=/run/secrets/querypilot_users
GROQ_API_KEY_FILE=
QUERYPILOT_USERS_FILE=

# Where the secrets directory lives on the host. Defaults to ./deploy/secrets.
QUERYPILOT_SECRETS_DIR=

# Host ports for the `tls` profile (T7), which is off unless you ask for it
# with `docker compose --profile tls up -d`. Not 80 and 443, because those are
# privileged on Linux and usually taken on a laptop.
TLS_HTTP_PORT=8080
TLS_HTTPS_PORT=8443
